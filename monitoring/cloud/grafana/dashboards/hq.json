{
  "uid": "ensp-hq",
  "title": "企业总部监控",
  "description": "HEAD_FW1/FW2（VRRP HA）+ SERVER_FW + 无线AC + DHCP，防火墙走 GE0/0/0 带外管理口 192.168.88.0/24",
  "tags": ["ensp", "hq"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "设备在线",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ensp_device_up{group=\"hq\"} == 1)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 5 }] }, "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 2, "type": "stat", "title": "设备总数",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ensp_device_up{group=\"hq\"})", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] }, "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3, "type": "gauge", "title": "平均 CPU 利用率",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "avg(ensp_cpu_usage_percent{group=\"hq\"})", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 60 }, { "color": "red", "value": 80 }] }, "noValue": "N/A" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 4, "type": "stat", "title": "接口 UP 数",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ensp_interface_oper_up{group=\"hq\"} == 1)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] }, "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 5, "type": "timeseries", "title": "各设备 CPU 利用率 (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ensp_cpu_usage_percent{group=\"hq\"}", "legendFormat": "{{device}}", "range": true }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "边界防火墙 GE1/0/6（untrust 出口）流量 (bps)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (device, interface) (rate(ensp_interface_in_octets_total{group=\"hq\", device=~\"HEAD_FW.*\", interface=~\".*1/0/6\"}[$__rate_interval])) * 8", "legendFormat": "{{device}} {{interface}} IN", "range": true },
        { "refId": "B", "expr": "sum by (device, interface) (rate(ensp_interface_out_octets_total{group=\"hq\", device=~\"HEAD_FW.*\", interface=~\".*1/0/6\"}[$__rate_interval])) * 8", "legendFormat": "{{device}} {{interface}} OUT", "range": true }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "接口入向流量 TOP10 (bps)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (device, interface) (rate(ensp_interface_in_octets_total{group=\"hq\"}[$__rate_interval])) * 8)", "legendFormat": "{{device}} {{interface}}", "range": true }],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8, "type": "table", "title": "设备状态清单",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ensp_device_up{group=\"hq\"}", "instant": true, "range": false, "format": "table" }],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.hidden", "value": true }] },
        { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "在线(1)/离线(0)" }, { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "在线", "color": "green" }, "0": { "text": "离线", "color": "red" } } }] }] }
      ] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}
